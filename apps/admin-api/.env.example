# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Interface to bind. 0.0.0.0 inside Docker; keep 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1
APP_URL=http://localhost:5000
# Where uploaded images are stored (served at /uploads). Defaults to ./uploads.
# UPLOAD_DIR=/var/lib/pharma-connect/uploads

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated website origin(s). Required in production, and `*` is rejected there.
CORS_ORIGIN=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pharma:hamza123@localhost:5432/mydb

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-must-be-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLER_TTL=60
THROTTLER_LIMIT=100
