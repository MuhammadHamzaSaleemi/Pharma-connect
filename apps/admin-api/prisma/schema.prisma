generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String       @id @default(cuid())
  email                    String       @unique
  name                     String
  avatar                   String?
  password                 String
  role                     UserRole     @default(ADMIN)
  status                   UserStatus   @default(ACTIVE)
  provider                 AuthProvider @default(LOCAL)
  refreshTokenHash         String?
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
  tokenValidFrom           DateTime     @default(now())
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  jobs                     Job[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EXECUTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model Job {
  id             String      @id @default(cuid())
  title          String
  company        String
  city           String
  qualification  String
  jobDescription String      @db.Text
  experience     String
  workType       JobWorkType
  jobFunction    String
  status         JobStatus   @default(DRAFT)
  sector         JobSector
  // Job creator (shown in per-owner stats). Null for jobs created before ownership
  // was tracked, or whose creator was deleted.
  createdById    String?
  createdBy      User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([sector])
  @@index([workType])
  @@index([city])
  @@map("jobs")
}

enum JobWorkType {
  ON_SITE
  HYBRID
  REMOTE
  FIELD_BASED
}

enum JobSector {
  PRODUCTION
  QUALITY_ASSURANCE
  QUALITY_CONTROL
  REGULATORY_AFFAIRS
  PHARMACOVIGILANCE
  CLINICAL_RESEARCH
  MEDICAL_AFFAIRS
  SALES_MARKETING
  WAREHOUSE
  SUPPLY_CHAIN
  COMMUNITY_PHARMACY
  HOSPITAL_PHARMACY
  ACADEMIA
  MANUFACTURING
  FORMULATION_DEVELOPMENT
  VALIDATION
  MICROBIOLOGY
  BIOTECHNOLOGY
  HOSPITALITY
  GOVERNMENT
  NGO
}

enum JobStatus {
  DRAFT
  ACTIVE
  INACTIVE
  CLOSED
}

model Scholarship {
  id                  String            @id @default(cuid())
  image               String
  country             String
  startDate           DateTime
  endDate             DateTime
  financialBenefits   String            @db.Text
  eligibilityCriteria String            @db.Text
  howToApply          String            @db.Text
  status              ScholarshipStatus @default(DRAFT)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([country])
  @@index([startDate])
  @@index([endDate])
  @@map("scholarships")
}

enum ScholarshipStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

model Blog {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  content        String     @db.Text
  excerpt        String?
  featuredImage  String?
  category       String?
  tags           String[]   @default([])
  status         BlogStatus @default(DRAFT)
  isFeatured     Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  // Byline shown on the post, edited in the blog form. No defaults: a post stores only the
  // author details it was given, and the website renders fallbacks for missing ones.
  authorName     String?
  authorTitle    String?
  authorBio      String?    @db.Text
  authorImage    String?
  authorLinkedin String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([category])
  @@map("blogs")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}
